{
  "name": "aegis",
  "private": true,
  "version": "0.2.3",
  "description": "Agent Skills + CLI that learn an insurance backend and its business features from a reference app, then integrate them into any stack and any state manager (Learn → Ask → Do).",
  "type": "module",
  "bin": {
    "aegis": "bin/aegis.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs test",
    "test:ts": "node scripts/run-tests.mjs reference/ts",
    "test:all": "node scripts/run-tests.mjs test reference/ts",
    "scan-secrets": "node scripts/secret-scan.mjs .",
    "lint-skills": "node scripts/lint-skills.mjs",
    "vectors": "node scripts/gen-demo-vectors.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "spec",
    "profiles",
    "reference/ts",
    "reference/dart/lib",
    "reference/dart/test",
    "reference/dart/pubspec.yaml",
    "templates",
    "scripts",
    "examples",
    "install.sh",
    "install.ps1",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.vi.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haevynx/aegis.git"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "insurance",
    "api-integration",
    "react-native",
    "flutter",
    "cli"
  ],
  "homepage": "https://github.com/haevynx/aegis#readme",
  "bugs": {
    "url": "https://github.com/haevynx/aegis/issues"
  }
}
